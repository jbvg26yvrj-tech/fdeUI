# ============================================================================
# fde-api — пример переменных окружения
# Скопируйте в .env и подставьте реальные значения.
# Значения <...> ОБЯЗАТЕЛЬНЫ и не имеют значений по умолчанию в application.yml.
# ============================================================================

# --- База данных (обязательно) ---------------------------------------------
# В Kubernetes берутся из Secret int-postgres.
DB_HOST=<db-host>
DB_PORT=<db-port>
DB_NAME=<db-name>
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# --- Интеграция с fde-dispatcher (обязательно) ------------------------------
FDE_DISPATCHER_URL=<http://fde-dispatcher.fde.svc.cluster.local>

# --- CORS (обязательно) -----------------------------------------------------
# Список разрешённых origin'ов UI через запятую (без пробелов).
CORS_ALLOWED_ORIGINS=<https://fde-ui.example.ru>

# --- JWT-секреты (ОБЯЗАТЕЛЬНО, сильные секреты) ------------------------------
# Минимум 32 символа, НЕ должны содержать слово "default".
# В Kubernetes берутся из Secret web-ui.
# Сгенерировать, например: openssl rand -base64 48
JWT_ACCESS_SECRET=<strong-random-secret-min-32-chars>
JWT_REFRESH_SECRET=<strong-random-secret-min-32-chars>

# ============================================================================
# Операционные параметры — имеют значения по умолчанию, менять не обязательно.
# ============================================================================

# --- HTTP-сервер ------------------------------------------------------------
SERVER_PORT=8082

# --- Таймауты обращения к dispatcher ----------------------------------------
FDE_DISPATCHER_CONNECT_TIMEOUT=5s
FDE_DISPATCHER_RESPONSE_TIMEOUT=30s

# --- Время жизни JWT-токенов (миллисекунды) ---------------------------------
JWT_ACCESS_EXPIRATION=600000
JWT_REFRESH_EXPIRATION=9000000

# --- Логирование ------------------------------------------------------------
LOG_LEVEL=INFO
